# Ecosystems Evaluate Configuration
# Copy this file to .env and fill in your values

# ===== Platform Configuration =====
# Platform: gitlab, github, or ado
PLATFORM=gitlab

# Platform URL
SOURCE=https://gitlab.com

# Your personal access token
TOKEN=your_token_here

# Organization/group name
ORG=your_org_here

# Optional: Number of parallel workers (default: 4)
WORKERS=4

# ===== Chainguard Coverage Credentials (Optional) =====
# Only needed if you want to run coverage analysis (--coverage flag)
# Get tokens from: https://console.chainguard.dev/

# Python packages
CHAINGUARD_PYTHON_USERNAME=your_python_username
CHAINGUARD_PYTHON_PASSWORD=your_python_token

# Java packages
CHAINGUARD_JAVA_USERNAME=your_java_username
CHAINGUARD_JAVA_PASSWORD=your_java_token
