# Configuration
# Copy this file to .env and fill in your values

# ===== Platform Configuration =====
# Platform: gitlab, github, or ado
PLATFORM=github

# Platform URL
SOURCE=https://github.com

# Your personal access token
TOKEN=your_token_here

# Organization/group name
ORG=your_org_here

# Optional: Number of parallel workers (default: 4)
WORKERS=4

# ===== Trusted Registries (Optional) =====
# Comma-separated regex patterns for image sources you consider trusted.
# Images matching these count toward adoption stats and are exempt from
# risky-image heuristics.
# Example: TRUSTED_REGISTRIES=cgr.dev,registry.example.com/secure
TRUSTED_REGISTRIES=

# ===== Persistence (Optional) =====
# PostgreSQL database URL for persisting analysis results.
# Uses pg8000 driver bundled in requirements.txt.
# Example: postgresql+pg8000://user:pass@localhost:5432/ecosystem_evaluate
DATABASE_URL=
